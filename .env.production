# === PRODUCTION ENVIRONMENT VARIABLES ===
# Northacoustics Field Clean Application
# Server: condor-core (Ubuntu)
# Date: 2026-05-20

# === NODE ENVIRONMENT ===
NODE_ENV=production

# === EXPO CONFIGURATION ===
EXPO_PUBLIC_API_URL=http://north-field-nginx:3111
EXPO_PUBLIC_LOCATION_TRACKING=true
EXPO_PUBLIC_OFFLINE_MODE=true

# === APPLICATION METADATA ===
REACT_APP_VERSION=1.0.0
REACT_APP_BUILD_DATE=2026-05-20
REACT_APP_ENVIRONMENT=production

# === DOCKER COMPOSE ===
COMPOSE_PROJECT_NAME=north-field
RESTART_POLICY=unless-stopped
BUILD_DATE=2026-05-20

# === FUTURE INTEGRATIONS (Placeholders) ===
