# NorthAcoustics - Staging environment
# Do not commit real secrets. Use staging Supabase project and test users only.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://staging-your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key
EXPO_PUBLIC_ENABLE_DEMO_MODE=false

# Web app (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://staging-your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=https://staging.northacoustics.cl

# Server-only web and Edge Function secrets
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
SUPABASE_URL=https://staging-your-project.supabase.co
SUPABASE_ANON_KEY=<staging-anon-key>

# Contact API integration
CONTACT_SUBMISSIONS_WEBHOOK_URL=https://staging-webhook.example/northacoustics-contact

# Supabase CLI / CI
SUPABASE_ACCESS_TOKEN=<staging-supabase-access-token>
SUPABASE_PROJECT_REF=<staging-project-ref>
