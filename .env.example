# ============================================================================
# NORTHACOUSTICS - Environment Variables Template
#
# COPY this file to .env.local and fill in your actual values
# NEVER commit .env.local to git
#
# Only NEXT_PUBLIC_* and EXPO_PUBLIC_* are safe to commit (they're public)
# Everything else MUST be in .gitignore
# ============================================================================

# ============================================================================
# SUPABASE - Web App (Next.js)
# These are PUBLIC keys - safe to commit with NEXT_PUBLIC_ prefix
# Get from: Supabase Dashboard > Settings > API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# SUPABASE - Mobile App (Expo)
# These are PUBLIC keys - safe to commit with EXPO_PUBLIC_ prefix
# Get from: Supabase Dashboard > Settings > API
# ============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# API ENDPOINTS
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================================================
# SECURITY NOTES
# ============================================================================
# DO NOT EVER COMMIT:
# - SUPABASE_SERVICE_ROLE_KEY (goes to GitHub Secrets)
# - SUPABASE_DB_PASSWORD (goes to 1Password)
# - Real values of any secret
#
# WORKFLOW:
# 1. cp .env.example .env.local
# 2. Edit .env.local with YOUR values
# 3. .env.local is in .gitignore
# 4. npm run dev
# ============================================================================
