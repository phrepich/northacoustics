# NorthAcoustics - Production environment
# Do not commit real secrets. Configure these in the hosting/CI secret manager.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://prod-your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=prod-anon-key
EXPO_PUBLIC_ENABLE_DEMO_MODE=false

# Web app (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://prod-your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=prod-anon-key
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=https://northacoustics.cl

# Server-only web and Edge Function secrets
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>
SUPABASE_URL=https://prod-your-project.supabase.co
SUPABASE_ANON_KEY=<production-anon-key>

# Contact API integration
CONTACT_SUBMISSIONS_WEBHOOK_URL=https://prod-webhook.example/northacoustics-contact

# Supabase CLI / CI
SUPABASE_ACCESS_TOKEN=<production-supabase-access-token>
SUPABASE_PROJECT_REF=<production-project-ref>
