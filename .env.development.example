# NorthAcoustics - Development environment
# Do not commit real secrets. Copy to .env or platform-specific local env files.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://dev-your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dev-anon-key
EXPO_PUBLIC_ENABLE_DEMO_MODE=true

# Web app (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://dev-your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dev-anon-key
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only web and Edge Function secrets
SUPABASE_SERVICE_ROLE_KEY=<development-service-role-key>
SUPABASE_URL=https://dev-your-project.supabase.co
SUPABASE_ANON_KEY=<development-anon-key>

# Contact API integration
CONTACT_SUBMISSIONS_WEBHOOK_URL=https://dev-webhook.example/northacoustics-contact

# Supabase CLI / CI
SUPABASE_ACCESS_TOKEN=<development-supabase-access-token>
SUPABASE_PROJECT_REF=<development-project-ref>
